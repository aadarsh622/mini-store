# Local development — copy to .env:
#   cp .env.example .env
# Production — see .env.production.example (values go in Render dashboard).
# Never commit real secrets.

NODE_ENV=development
PORT=5000
HOST=0.0.0.0

# MongoDB — local or Atlas connection string
MONGO_URI=mongodb://127.0.0.1:27017/mini_store

# Auth
JWT_SECRET=dev_only_change_me
JWT_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=10

# Frontend origin(s) for CORS — must match the browser origin exactly
# Local: http://localhost:5173
# Prod:  https://YOUR_VERCEL_APP.vercel.app  (comma-separate extras)
CLIENT_URL=http://localhost:5173

# Public API URL (payment gateway callbacks) — no trailing slash
# Local: http://localhost:5000
# Prod:  https://mini-store-backend.onrender.com
API_PUBLIC_URL=http://localhost:5000

# Optional email (Resend)
RESEND_API_KEY=
MAIL_FROM=Mini Store <onboarding@resend.dev>

# Uploads
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=5

# Persistent product image storage (Cloudinary)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# PhonePe (sandbox defaults)
PHONEPE_BASE_URL=https://api-preprod.phonepe.com
PHONEPE_CLIENT_ID=TEST
PHONEPE_CLIENT_VERSION=1
PHONEPE_SALT_KEY=TEST_SALT
PHONEPE_MERCHANT_ID=TEST_MERCHANT
