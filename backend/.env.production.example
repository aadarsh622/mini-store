# Production env for Render (or any host).
# Copy these into the Render dashboard → Environment, or:
#   cp .env.production.example .env.production
# Then replace the placeholder URLs / secrets before deploy.
#
# Do NOT commit real secrets. Render injects PORT automatically — leave it unset.

NODE_ENV=production
HOST=0.0.0.0

# MongoDB Atlas (required)
MONGO_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/mini_store?retryWrites=true&w=majority

# Auth — use a long random string (openssl rand -hex 32)
JWT_SECRET=REPLACE_WITH_LONG_RANDOM_SECRET
JWT_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=10

# Frontend origin(s) for CORS — must match your Vercel URL exactly (no trailing slash).
# Comma-separate extra origins (custom domain, preview deploys) if needed.
CLIENT_URL=https://YOUR_VERCEL_APP.vercel.app

# This backend's public URL (no trailing slash). Used for payment callbacks.
# After first Render deploy, copy the service URL here (and into frontend VITE_API_URL).
API_PUBLIC_URL=https://mini-store-backend.onrender.com

# Optional email (Resend)
RESEND_API_KEY=
MAIL_FROM=Mini Store <onboarding@resend.dev>

# Legacy local upload settings (product images use Cloudinary)
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=5

# Persistent product image storage (Cloudinary)
CLOUDINARY_CLOUD_NAME=YOUR_CLOUDINARY_CLOUD_NAME
CLOUDINARY_API_KEY=YOUR_CLOUDINARY_API_KEY
CLOUDINARY_API_SECRET=YOUR_CLOUDINARY_API_SECRET

# PhonePe — swap to production credentials when going live
PHONEPE_BASE_URL=https://api-preprod.phonepe.com
PHONEPE_CLIENT_ID=TEST
PHONEPE_CLIENT_VERSION=1
PHONEPE_SALT_KEY=TEST_SALT
PHONEPE_MERCHANT_ID=TEST_MERCHANT
